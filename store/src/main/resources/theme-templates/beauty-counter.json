{
  "code": "beauty-counter",
  "name": "Beauty Counter",
  "category": "Beauty",
  "description": "Soft and unhurried. Three-column categories, a curated shelf and a promise strip.",
  "shopType": null,
  "sortOrder": 50,
  "config": {
    "schemaVersion": 1,
    "tokens": {
      "primary": "#9d4b63",
      "background": "#fffaf9",
      "foreground": "#241417",
      "muted": "#fbeef0",
      "accent": "#f4dde1",
      "border": "#efd9dd",
      "ring": "#9d4b63",
      "fontHeading": "Georgia, 'Times New Roman', serif",
      "fontBody": "Arial, Helvetica, sans-serif",
      "radius": "1rem",
      "mode": "light"
    },
    "sections": [
      {
        "id": "announcement",
        "type": "announcement-bar",
        "props": {
          "text": "Authentic products · Free samples with every order",
          "dismissible": false
        }
      },
      {
        "id": "header",
        "type": "site-header",
        "props": {
          "showShopName": true,
          "showLogo": true,
          "showSearch": true,
          "sticky": true,
          "links": []
        }
      },
      {
        "id": "hero",
        "type": "hero",
        "variant": "centered",
        "props": {
          "heading": "Skincare that earns its place",
          "subheading": "A short shelf of products we have used ourselves — cleansers, serums and sunscreens for Nepal's dust and sun.",
          "imageUrl": "asset:HERO/main",
          "cta": {
            "label": "Shop the shelf",
            "href": "#products"
          }
        }
      },
      {
        "id": "categories",
        "type": "category-grid",
        "props": {
          "columns": 3,
          "source": "shop_categories",
          "limit": 6,
          "heading": "Shop by category",
          "tone": "muted"
        }
      },
      {
        "id": "products",
        "type": "product-carousel",
        "props": {
          "heading": "Loved right now",
          "source": "latest",
          "limit": 8
        }
      },
      {
        "id": "promise",
        "type": "feature-list",
        "props": {
          "heading": "What we promise",
          "items": [
            "Authentic stock, sourced directly",
            "Samples so you can try before you buy",
            "No lectures about your skin"
          ],
          "tone": "muted"
        }
      },
      {
        "id": "newsletter",
        "type": "newsletter",
        "props": {
          "heading": "The routine guide",
          "subheading": "A short monthly note on what to use, and in what order."
        }
      },
      {
        "id": "footer",
        "type": "site-footer",
        "props": {
          "columns": [],
          "showPaymentBadges": true
        }
      }
    ],
    "nav": {
      "menu": [
        {
          "label": "Shop",
          "href": "#products"
        },
        {
          "label": "Categories",
          "href": "#categories"
        }
      ]
    },
    "footer": {
      "assetHandle": "footer-main",
      "columns": 3,
      "showPaymentBadges": true
    },
    "layout": {
      "width": "standard",
      "header": "centered",
      "card": "plain",
      "bands": true,
      "display": "editorial"
    }
  }
}
