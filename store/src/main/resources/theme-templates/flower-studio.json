{
  "code": "flower-studio",
  "name": "Flower Studio",
  "category": "Flowers",
  "description": "Romantic and light. A tall hero, three-column bouquets and a same-day note.",
  "shopType": null,
  "sortOrder": 120,
  "config": {
    "schemaVersion": 1,
    "tokens": {
      "primary": "#8c3b52",
      "background": "#fdf8f7",
      "foreground": "#251418",
      "muted": "#f9edef",
      "accent": "#f2d3d9",
      "border": "#eedae0",
      "ring": "#8c3b52",
      "fontHeading": "Georgia, 'Times New Roman', serif",
      "fontBody": "Arial, Helvetica, sans-serif",
      "radius": "1.75rem",
      "mode": "light"
    },
    "sections": [
      {
        "id": "announcement",
        "type": "announcement-bar",
        "props": {
          "text": "Same-day delivery before 2pm · Hand-tied bouquets",
          "dismissible": false
        }
      },
      {
        "id": "header",
        "type": "site-header",
        "props": {
          "showShopName": true,
          "showLogo": true,
          "showSearch": true,
          "sticky": true,
          "links": []
        }
      },
      {
        "id": "hero",
        "type": "hero",
        "variant": "split-image",
        "props": {
          "heading": "Flowers for the days that matter",
          "subheading": "Hand-tied bouquets and seasonal stems, delivered across the Valley the same day.",
          "imageUrl": "asset:HERO/main",
          "cta": {
            "label": "See this week's flowers",
            "href": "#products"
          }
        }
      },
      {
        "id": "products",
        "type": "product-grid",
        "props": {
          "heading": "This week's bouquets",
          "source": "latest",
          "limit": 6,
          "columns": 3
        }
      },
      {
        "id": "story",
        "type": "image-with-text",
        "props": {
          "heading": "Cut, conditioned and tied by hand",
          "body": "Stems arrive from two growers in Dhulikhel every morning. We condition them for a few hours, then tie each bouquet to order, so it opens at home rather than in the van.",
          "imageUrl": "",
          "imagePosition": "left"
        }
      },
      {
        "id": "cta",
        "type": "cta-banner",
        "props": {
          "heading": "Sending something today?",
          "body": "Order before 2pm and we will deliver inside the ring road the same afternoon.",
          "cta": {
            "label": "Choose a bouquet",
            "href": "#products"
          }
        }
      },
      {
        "id": "newsletter",
        "type": "newsletter",
        "props": {
          "heading": "What's in season",
          "subheading": "A short note when the growers change what they are cutting."
        }
      },
      {
        "id": "footer",
        "type": "site-footer",
        "props": {
          "columns": [],
          "showPaymentBadges": true
        }
      }
    ],
    "nav": {
      "menu": [
        {
          "label": "Bouquets",
          "href": "#products"
        },
        {
          "label": "Studio",
          "href": "#story"
        }
      ]
    },
    "footer": {
      "assetHandle": "footer-main",
      "columns": 3,
      "showPaymentBadges": true
    }
  }
}
