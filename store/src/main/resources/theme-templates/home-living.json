{
  "code": "home-living",
  "name": "Home & Living",
  "category": "Home & living",
  "description": "Calm and roomy. A centred opening, a maker story and a three-column room grid.",
  "shopType": null,
  "sortOrder": 60,
  "config": {
    "schemaVersion": 1,
    "tokens": {
      "primary": "#4f5d4a",
      "background": "#fbfaf6",
      "foreground": "#1d231b",
      "muted": "#f1efe7",
      "accent": "#ddd8c8",
      "border": "#e0dccf",
      "ring": "#4f5d4a",
      "fontHeading": "Georgia, 'Times New Roman', serif",
      "fontBody": "Arial, Helvetica, sans-serif",
      "radius": "0.25rem",
      "mode": "light"
    },
    "sections": [
      {
        "id": "announcement",
        "type": "announcement-bar",
        "props": {
          "text": "Free delivery on orders over Rs. 3,000",
          "dismissible": false
        }
      },
      {
        "id": "header",
        "type": "site-header",
        "props": {
          "showShopName": true,
          "showLogo": true,
          "showSearch": true,
          "sticky": true,
          "links": []
        }
      },
      {
        "id": "hero",
        "type": "hero",
        "variant": "split-image",
        "props": {
          "heading": "Things for the home you actually live in",
          "subheading": "Ceramics, linen and small furniture, chosen for daily use rather than the shelf.",
          "imageUrl": "asset:HERO/main",
          "cta": {
            "label": "Shop the house",
            "href": "#products"
          }
        }
      },
      {
        "id": "story",
        "type": "image-with-text",
        "props": {
          "heading": "Made by hand, used every day",
          "body": "Most of what we stock comes from workshops within a day's drive — potters in Bhaktapur, a weaver in Patan, a carpenter who will repair what he sold you. We buy in small numbers and we know who made each piece.",
          "imageUrl": "",
          "imagePosition": "left"
        }
      },
      {
        "id": "products",
        "type": "product-grid",
        "props": {
          "heading": "New in the house",
          "source": "latest",
          "limit": 6,
          "columns": 3
        }
      },
      {
        "id": "categories",
        "type": "category-grid",
        "props": {
          "columns": 4,
          "source": "shop_categories",
          "limit": 8,
          "heading": "By room",
          "tone": "muted"
        }
      },
      {
        "id": "trust",
        "type": "trust-badges",
        "props": {
          "items": [
            "Handmade in Nepal",
            "Care instructions included",
            "Delivery across the Valley"
          ],
          "tone": "muted"
        }
      },
      {
        "id": "newsletter",
        "type": "newsletter",
        "props": {
          "heading": "New pieces, once a month",
          "subheading": "What came into the shop, and who made it."
        }
      },
      {
        "id": "footer",
        "type": "site-footer",
        "props": {
          "columns": [],
          "showPaymentBadges": true
        }
      }
    ],
    "nav": {
      "menu": [
        {
          "label": "Shop",
          "href": "#products"
        },
        {
          "label": "Rooms",
          "href": "#categories"
        }
      ]
    },
    "footer": {
      "assetHandle": "footer-main",
      "columns": 3,
      "showPaymentBadges": true
    },
    "layout": {
      "width": "wide",
      "header": "minimal",
      "card": "plain",
      "bands": true,
      "display": "editorial"
    }
  }
}
