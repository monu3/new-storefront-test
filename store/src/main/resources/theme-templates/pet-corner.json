{
  "code": "pet-corner",
  "name": "Pet Corner",
  "category": "Pets",
  "description": "Friendly and round. A centred welcome, pet categories and a questions block.",
  "shopType": null,
  "sortOrder": 110,
  "config": {
    "schemaVersion": 1,
    "tokens": {
      "primary": "#b45309",
      "background": "#fffbf5",
      "foreground": "#241a10",
      "muted": "#fdf1e0",
      "accent": "#fbd9a5",
      "border": "#f2e0c9",
      "ring": "#b45309",
      "fontHeading": "Arial, Helvetica, sans-serif",
      "fontBody": "Arial, Helvetica, sans-serif",
      "radius": "1.25rem",
      "mode": "light"
    },
    "sections": [
      {
        "id": "announcement",
        "type": "announcement-bar",
        "props": {
          "text": "Vet-approved food · Free delivery over Rs. 1,500",
          "dismissible": false
        }
      },
      {
        "id": "header",
        "type": "site-header",
        "props": {
          "showShopName": true,
          "showLogo": true,
          "showSearch": true,
          "sticky": true,
          "links": []
        }
      },
      {
        "id": "hero",
        "type": "hero",
        "variant": "split-image",
        "props": {
          "heading": "Everything for the ones with paws",
          "subheading": "Food, litter, toys and the small things you run out of on a Sunday evening.",
          "imageUrl": "asset:HERO/main",
          "cta": {
            "label": "Shop for your pet",
            "href": "#products"
          }
        }
      },
      {
        "id": "categories",
        "type": "category-grid",
        "props": {
          "columns": 4,
          "source": "shop_categories",
          "limit": 8,
          "heading": "Shop by pet",
          "tone": "muted"
        }
      },
      {
        "id": "products",
        "type": "product-carousel",
        "props": {
          "heading": "Popular this week",
          "source": "latest",
          "limit": 8
        }
      },
      {
        "id": "faq",
        "type": "faq",
        "props": {
          "heading": "Questions from pet parents",
          "items": [
            {
              "q": "Can I order a month of food at once?",
              "a": "Yes. Bulk bags are delivered free inside the Valley."
            },
            {
              "q": "Do you stock prescription diets?",
              "a": "Some. Send a photograph of the prescription and we will confirm."
            }
          ]
        }
      },
      {
        "id": "newsletter",
        "type": "newsletter",
        "props": {
          "heading": "Join the pack",
          "subheading": "New stock, and the occasional photo of a customer."
        }
      },
      {
        "id": "footer",
        "type": "site-footer",
        "props": {
          "columns": [],
          "showPaymentBadges": true
        }
      }
    ],
    "nav": {
      "menu": [
        {
          "label": "Shop",
          "href": "#products"
        },
        {
          "label": "Pets",
          "href": "#categories"
        }
      ]
    },
    "footer": {
      "assetHandle": "footer-main",
      "columns": 3,
      "showPaymentBadges": true
    },
    "layout": {
      "width": "wide",
      "header": "pill",
      "card": "bordered",
      "bands": true,
      "display": "default"
    }
  }
}
