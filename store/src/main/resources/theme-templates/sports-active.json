{
  "code": "sports-active",
  "name": "Sports Active",
  "category": "Sports",
  "description": "Bold and direct. Heavy headings, a four-column gear grid and a straight-talking FAQ.",
  "shopType": null,
  "sortOrder": 90,
  "config": {
    "schemaVersion": 1,
    "tokens": {
      "primary": "#141414",
      "background": "#fbfbf8",
      "foreground": "#101010",
      "muted": "#eff0e8",
      "accent": "#dcff4d",
      "border": "#e2e3da",
      "ring": "#141414",
      "fontHeading": "Arial, Helvetica, sans-serif",
      "fontBody": "Arial, Helvetica, sans-serif",
      "radius": "0rem",
      "mode": "light"
    },
    "sections": [
      {
        "id": "announcement",
        "type": "announcement-bar",
        "props": {
          "text": "Free shipping over Rs. 2,500 · 14-day exchange",
          "dismissible": false
        }
      },
      {
        "id": "header",
        "type": "site-header",
        "props": {
          "showShopName": true,
          "showLogo": true,
          "showSearch": true,
          "sticky": true,
          "links": []
        }
      },
      {
        "id": "hero",
        "type": "hero",
        "variant": "panel",
        "props": {
          "heading": "Train for the week you actually have",
          "subheading": "Shoes, weights and layers that survive a real schedule — not a photoshoot.",
          "cta": {
            "label": "Shop the gear",
            "href": "#products"
          }
        }
      },
      {
        "id": "products",
        "type": "product-grid",
        "props": {
          "heading": "Gear that works",
          "source": "latest",
          "limit": 8,
          "columns": 4
        }
      },
      {
        "id": "reasons",
        "type": "feature-list",
        "props": {
          "heading": "Why athletes buy here",
          "items": [
            "Fitted at the shop, not guessed online",
            "Exchange worn-once shoes within 14 days",
            "Team and gym orders priced on request"
          ]
        }
      },
      {
        "id": "cta",
        "type": "cta-banner",
        "props": {
          "heading": "Not sure what you need?",
          "body": "Tell us your sport and your week. We will point you at two options, not twelve.",
          "cta": {
            "label": "See best sellers",
            "href": "#products"
          }
        }
      },
      {
        "id": "trust",
        "type": "trust-badges",
        "props": {
          "items": [
            "Free shipping over Rs. 2,500",
            "14-day exchange",
            "Cash on delivery"
          ]
        }
      },
      {
        "id": "footer",
        "type": "site-footer",
        "props": {
          "columns": [],
          "showPaymentBadges": true
        }
      }
    ],
    "nav": {
      "menu": [
        {
          "label": "Shop",
          "href": "#products"
        }
      ]
    },
    "footer": {
      "assetHandle": "footer-main",
      "columns": 3,
      "showPaymentBadges": true
    },
    "layout": {
      "width": "wide",
      "header": "bar",
      "card": "plain",
      "bands": false,
      "display": "compact"
    }
  }
}
