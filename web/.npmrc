# Hoist the toolchain so Vite/Next share one copy instead of one per package.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# pnpm blocks postinstall scripts by default. esbuild ships a platform binary that only
# materialises during its install script, so Vite and Turborepo cannot start without it.
# Listed here rather than approved interactively so a fresh clone builds the same way.
onlyBuiltDependencies:
  - esbuild
