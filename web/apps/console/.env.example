# Console (Vite). Copy to .env and fill in real values.
# All of these have localhost fallbacks, so the app boots without this file.

# Used by the dev proxy in vite.config.ts.
VITE_API_URL=http://localhost:8080
VITE_APP_URL=http://localhost:5173

# The customer storefront, a separate app. Used by "Visit your shop", "Preview store" and the
# customiser's Preview button, which must be absolute URLs — they leave this origin.
VITE_STOREFRONT_URL=http://localhost:3000

# Keycloak ops realm (D3). Only the ops realm may be used here.
VITE_KEYCLOAK_URL=https://auth-master.yenyasoft.com
VITE_KEYCLOAK_OPS_CLIENT_ID=store-app-console
VITE_KEYCLOAK_OPS_REALM=ops

# Phase 5
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
