    "@store-app/icons": "workspace:*",
    "@store-app/state": "workspace:*",
    "@store-app/theme-engine": "workspace:*",
    "@store-app/ui": "workspace:*",
    "@store-app/validation": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@store-app/config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
