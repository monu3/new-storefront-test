# Customer portal (Next.js). Copy to .env.local and fill in real values.
#
# The dev server runs without this file. A PRODUCTION build does not: `env()` in
# packages/auth fails hard on a missing variable rather than falling back, so that a real
# deployment can never silently inherit a development Keycloak URL.

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keycloak customer realm (D3). Only the customers realm may be used here.
NEXT_PUBLIC_KEYCLOAK_URL=https://auth-master.yenyasoft.com
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=store-app-customer-web
NEXT_PUBLIC_CUSTOMER_REALM=customers

# Phase 5
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Shared with the customer portal so a published theme appears immediately.
STOREFRONT_REVALIDATE_SECRET=local-dev-revalidate-secret
