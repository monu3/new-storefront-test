{
  "name": "@store-app/icons",
  "version": "0.0.1",
  "private": true,
  "description": "Curated react-icons re-exports. The API names an icon (e.g. 'Pill') and this maps it to a component, so the backend never ships JSX.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured for icons\"",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2",
    "@store-app/config": "workspace:*"
  }
}
